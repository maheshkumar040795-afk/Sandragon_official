rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Add every admin's Firebase Auth email here to match js/config.js adminEmails
      return request.auth != null &&
        request.auth.token.email in ['sandragonofficial@gmail.com'];
    }

    // Products: anyone can read, only admin can write — except two narrow
    // customer-triggered updates:
    //  1. the denormalized rating aggregate, bumped via increment() when a
    //     review is submitted (restricted to those two numeric fields).
    //  2. the stock count, decremented at checkout so the storefront and
    //     admin panel both reflect what's left. Restricted to the 'stock'
    //     field alone, and only allowed to move it down (never up, never
    //     negative) — a customer's browser can never use this to restock.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if !isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingCount', 'ratingSum']);
      allow update: if !isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
        request.resource.data.stock is number &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock < resource.data.stock;

      // Reviews: anyone can post a review (same lightweight trust model as
      // orders/customers — no login wall for a small storefront) and read
      // them; only admin can edit or remove one (e.g. to take down spam).
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['name', 'rating', 'comment', 'createdAt']) &&
          request.resource.data.rating is number &&
          request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() < 80 &&
          request.resource.data.comment.size() < 1000;
        allow update, delete: if isAdmin();
      }
    }

    // Coupons: public read (so the cart can validate a code) and a narrow
    // public update limited to bumping usageCount at checkout; everything
    // else (create/delete/edit terms) is admin-only.
    match /coupons/{code} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']);
    }

    // Orders: anyone can create an order (checkout), only admin can read/update the list.
    // Customer order tracking reads happen through a phone-number query — since Firestore
    // rules can't verify "the phone is really theirs", keep tracking read-only and non-sensitive
    // (no card/payment secrets are ever stored), or move tracking behind a Cloud Function later.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // Customers: lightweight "account" keyed by phone number, same trust model as
    // orders above (no real auth — phone number is a convenience identifier, not a
    // verified credential). No payment/card data is ever stored here.
    match /customers/{phone} {
      allow read, write: if true;
    }

    // Settings: site-wide config docs (e.g. the homepage banner carousel,
    // delivery charge). Anyone can read (public storefront content), only
    // admin can write.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ads: promotional ad banners posted from Admin → Banners → Promotional
    // Ads. Public read (storefront needs to display active ones), admin-only
    // write (post/edit/delete).
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories: admin-managed from Admin → Categories. Public read (the
    // storefront's filter pills, mega-menu, and the admin product form's
    // dropdown all read this live), admin-only write (add/rename/delete).
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
